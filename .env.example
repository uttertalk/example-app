# Your Utter project. Create one at https://app.utter.talk/signup
UTTER_PROJECT=your-project-id
# Keep this on the server. It signs every call between this app and Utter.
UTTER_SECRET=your-project-secret
# Only if you use a different Utter address.
# UTTER_URL=

# Optional: a Postgres database. Without it, data is kept in a local file in .data/
# DATABASE_URL=
